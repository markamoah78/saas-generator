# ─────────────────────────────────────────────────────────────────────────
# ENV VARS FOR NEXT.JS (this file becomes .env.local, read by `next dev`)
# ─────────────────────────────────────────────────────────────────────────

# Written automatically the first time you run `npx convex dev`. Don't set
# these by hand — just run the command and it fills them in for you.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# The public URL of your app. http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Polar — used server-side (Server Actions) to create Checkout sessions.
# Dashboard → Settings → API Keys → "Create access token".
# Use "sandbox" while testing, switch to "production" when you go live.
# Sandbox and production have SEPARATE tokens/products — don't mix them.
POLAR_ACCESS_TOKEN=
POLAR_SERVER=sandbox
POLAR_PRO_MONTHLY_PRODUCT_ID=

# ─────────────────────────────────────────────────────────────────────────
# ENV VARS FOR CONVEX
# These do NOT go in .env.local — Convex functions run on Convex's own
# servers, not on Vercel, so they need their own env store. Set each one
# with:
#   npx convex env set NAME value
# (or add them in the Convex dashboard → Settings → Environment Variables)
# Listed here just so you have one place that tracks everything the
# project needs.
# ─────────────────────────────────────────────────────────────────────────

# BETTER_AUTH_SECRET=  (generate with: openssl rand -base64 32)
# SITE_URL=http://localhost:3000  (same value as NEXT_PUBLIC_SITE_URL above)
#
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
#
# POLAR_WEBHOOK_SECRET=   (Polar dashboard → Webhooks → your endpoint)
#
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=onboarding@resend.dev   (use your own verified domain in prod)
